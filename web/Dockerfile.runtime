# Runtime-only image for the SPA frontend.
# - 仅打包 nginx + deploy/nginx/default.conf，不打包 web/dist。
# - web/dist 由宿主机 deploy/runtime/web/ 挂载到 /usr/share/nginx/html。
# - 镜像只在 nginx / alpine 升级或 deploy/nginx/default.conf 变化时重建。
# - 对应回退路径使用 web/Dockerfile（源码构建）。
FROM nginx:1.27-alpine

# 把仓库内的 nginx 配置烤进镜像；与 web/Dockerfile 第 11 行对齐。
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf

# 故意清空默认的欢迎页：忘记挂载 dist 时，nginx 会返回 403 而不是
# 静默地展示 "Welcome to nginx"，让问题尽早暴露。
RUN rm -rf /usr/share/nginx/html/*

EXPOSE 80