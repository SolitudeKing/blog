# =============================================================================
# Solitude Blog 生产环境 .env 模板
# =============================================================================
# 这是生产部署的参考模板，含占位符（<REPLACE_WITH_…>），可提交到仓库。
# 部署机上手工替换占位符为真实凭据；切勿把含真实密码的 .env 提交到版本库。
#
# 部署前必做（在部署机上执行）：
#   openssl rand -base64 64   # JWT_ACCESS_SECRET
#   openssl rand -base64 64   # JWT_REFRESH_SECRET（必须与 access 不同）
#   openssl rand -base64 24   # MYSQL_PASSWORD
#   openssl rand -base64 24   # MYSQL_ROOT_PASSWORD
#   openssl rand -base64 24   # REDIS_PASSWORD
#   openssl rand -base64 24   # ADMIN_PASSWORD
#   sed -i 's/<REPLACE_WITH_…>/实际值/g' .env
#   grep -rn 'REPLACE_WITH' .env  # 必须零结果
# =============================================================================

# ============ 应用运行时 ============
APP_ENV=production
APP_PORT=8080
APP_API_VERSION=v1
SITE_BASE_URL=https://www.solitude.love
WEB_PORT=80

# ============ MySQL ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3369
MYSQL_DATABASE=solitude_blog
MYSQL_USER=blog
MYSQL_PASSWORD=<REPLACE_WITH_STRONG_MYSQL_PASSWORD>
# 仅 Compose 启动 mysql 容器时需要；Go 服务不直接使用 root 账号。
MYSQL_ROOT_PASSWORD=<REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD>

# ============ Redis（6+ ACL） ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_USER=app
REDIS_PASSWORD=<REPLACE_WITH_STRONG_REDIS_PASSWORD>

# ============ JWT ============
# 每个 secret ≥32 字符、互不相同、不以 dev- 开头、不含 change-me。
JWT_ACCESS_SECRET=<REPLACE_WITH_64_RANDOM_BYTES_BASE64>
JWT_REFRESH_SECRET=<REPLACE_WITH_DIFFERENT_64_RANDOM_BYTES_BASE64>
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ============ 管理员 ============
# 首次启动会以这个账号建 owner；ADMIN_PASSWORD 不能为 admin 或含 change-me。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<REPLACE_WITH_STRONG_ADMIN_PASSWORD>
ADMIN_NICKNAME=Solitude King

# ============ 对象存储（MinIO/S3） ============
# 当前 driver: s3。bucket=blog 已由运维手工创建，应用只做 BucketExists 探测。
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=https://minio.solitude.love
STORAGE_S3_ACCESS_KEY=qwertyuui
STORAGE_S3_SECRET_KEY=pkdjcnxhs
STORAGE_S3_BUCKET=blog
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=true
# 外链前缀：浏览器通过此 URL 拉取上传对象。已含 /bucket 路径。
STORAGE_S3_PUBLIC_URL=https://minio.solitude.love/blog
# 本地驱动才用到的根目录；s3 模式下被忽略，保留以备回退。
STORAGE_LOCAL_ROOT=./storage/uploads