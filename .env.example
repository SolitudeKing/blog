APP_ENV=development
APP_PORT=8080
APP_API_VERSION=v1
# 完整 Compose 默认由 Nginx 的 80 端口提供站点；宿主机运行 Vite 时改为 http://localhost:5173。
SITE_BASE_URL=http://localhost

# 格式：blog:<与 MYSQL_PASSWORD 相同的密码>@tcp(mysql:3306)/blog?charset=utf8mb4&parseTime=True&loc=UTC
MYSQL_DSN=
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_PORT=6379

WEB_PORT=80

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=Solitude King

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
